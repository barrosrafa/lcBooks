# LLM atual
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TTS. Google Cloud usa Application Default Credentials e serviço habilitado.
TTS_PROVIDER=google_cloud
TTS_LANGUAGE=pt-BR
TTS_VOICE=pt-BR-Standard-A
TTS_SPEAKING_RATE=1.0

# Renderização
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
BURN_CAPTIONS=true

# Limites de segurança e processamento
MAX_PDF_MB=100
MAX_PDF_PAGES=1000
MAX_CHAPTER_CHARS_PER_CHUNK=12000
MAX_RETRY_ATTEMPTS=3
